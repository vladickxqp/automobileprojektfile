NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Local Postgres (e.g. docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autolife?schema=public
# Use a long random string in real environments
JWT_SECRET=dev-secret-change-me-please-0123456789
# AI assistant (#10). Without a key the assistant route returns 503; everything else works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
