{
  "expo": {
    "name": "CarDNA",
    "slug": "autolife",
    "scheme": "autolife",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.autolife.app"
    },
    "android": {
      "package": "com.autolife.app"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-image-picker",
      "react-native-ble-plx"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
